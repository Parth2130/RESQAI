# RESQAI Environment Configuration
# ==========================================

# Database Connection
# SQLite default: sqlite:///./resqai.db
# Supabase / PostgreSQL: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=sqlite:///./resqai.db

# JWT & Security
JWT_SECRET_KEY=resqai-super-secure-production-key-2026-disaster-response
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Default Initial Credentials (seeded on first boot)
INITIAL_ADMIN_EMAIL=admin@resqai.in
INITIAL_ADMIN_PASSWORD=ResqAdmin@2026
INITIAL_ADMIN_NAME=Emergency Control Officer

# Nugen AI Integration (Official documentation: docs.nugen.in / github.com/nugen-in/nugen-cookbook)
NUGEN_API_KEY=
NUGEN_MODEL=
NUGEN_BASE_URL=https://api.nugen.in/api/v3/inference/chat/completions

# Optional aliases
NUGEN_MODEL_ID=
NUGEN_API_URL=https://api.nugen.in/api/v3/inference/chat/completions

# NASA FIRMS Satellite Fire Telemetry (Optional)
NASA_FIRMS_MAP_KEY=
