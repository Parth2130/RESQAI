# RESQAI Environment Configuration
# ==========================================

# Database Connection (SQLite by default, ready for PostgreSQL: postgresql://user:password@localhost/resqai)
DATABASE_URL=sqlite:///./resqai.db

# JWT & Security
JWT_SECRET_KEY=replace-with-a-secure-random-secret-key-for-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Admin Credentials (used only if database is fresh)
INITIAL_ADMIN_EMAIL=admin@resqai.in
INITIAL_ADMIN_PASSWORD=ResqAdmin@2026
INITIAL_ADMIN_NAME=Emergency Control Officer

# AI Assistant - Nugen AI (Official API endpoint: https://api.nugen.in/api/v3/inference/chat/completions)
NUGEN_API_KEY=
NUGEN_MODEL_ID=
NUGEN_API_URL=https://api.nugen.in/api/v3/inference/chat/completions

# NASA FIRMS Satellite Fire Hotspot API Key (Optional)
# Obtain a free map key from https://firms.modaps.eosdis.nasa.gov/api/map_key/
NASA_FIRMS_MAP_KEY=
